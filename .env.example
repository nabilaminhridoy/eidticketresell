# Database
# For local development (SQLite):
DATABASE_URL=file:./db/custom.db

# For Vercel deployment (use PostgreSQL instead):
# DATABASE_URL=postgresql://user:password@host:5432/database

# NextAuth (optional - configure when ready)
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=https://your-domain.vercel.app

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_SANDBOX=true

# SSLCommerz Quick Bank Pay
SSLCOMMERZ_QBP_API_KEY=your_api_key
SSLCOMMERZ_QBP_STK_CODE=SSLC
SSLCOMMERZ_QBP_AUTH_KEY=your_auth_key

# SSLCommerz Google Pay
SSLCOMMERZ_GP_MERCHANT_ID=your_google_merchant_id
SSLCOMMERZ_GP_AES_SALT=F5d66a527ff181486321bf7c3s7f54de
