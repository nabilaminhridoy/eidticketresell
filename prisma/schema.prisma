generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?  @unique
  username      String   @unique
  name          String
  password      String
  avatar        String?
  gender        String?  // male, female, other
  dateOfBirth   String?
  role          String   @default("user") // guest, user, verified_seller, admin, super_admin
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  isKycVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  isDeleted     Boolean  @default(false)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  kyc           Kyc?
  wallet        Wallet?
  tickets       Ticket[]  @relation("SellerTickets")
  orders        Order[]   @relation("BuyerOrders")
  soldOrders    Order[]   @relation("SellerOrders")
  reviewsGiven  Review[]  @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")
  notifications Notification[]
  activities    ActivityLog[]
  chatParticipants ChatParticipant[]
  messages      Message[]  @relation("MessageSender")
  supportTickets SupportTicket[]
  referrals     Referral[] @relation("Referrer")
  referredBy    String?
  couponUsages  CouponUsage[]
}

model Kyc {
  id              String   @id @default(cuid())
  kycId           String   @unique // KYC-1, KYC-2, KYC-3
  userId          String   @unique
  // Personal info (can be changed once from profile)
  kycName         String
  kycDob          String?
  kycGender       String?
  nameChanged     Boolean  @default(false)
  dobChanged      Boolean  @default(false)
  genderChanged   Boolean  @default(false)
  // Document info
  documentType    String   // nid, driving_licence, passport
  documentNumber  String
  documentFront   String
  documentBack    String?
  // Present address
  houseRoadVillage String?
  upazilaThana    String?
  district        String?
  division        String?
  postalCode      String?
  // Selfie captures
  selfiePhoto     String
  selfieRight     String?
  selfieLeft      String?
  selfieSmile     String?
  selfieBlink     String?
  // GPS
  gpsLatitude     Float?
  gpsLongitude    Float?
  // Status
  status          String   @default("pending") // pending, approved, rejected
  reviewedBy      String?
  reviewNote      String?
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  availableBalance Float   @default(0)
  pendingBalance  Float    @default(0)
  escrowBalance   Float    @default(0)
  totalEarnings   Float    @default(0)
  totalWithdrawn  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  transactions  Transaction[]
  withdrawals   Withdrawal[]
}

model Transaction {
  id              String   @id @default(cuid())
  txnId           String   @unique // TXN-1, TXN-2, TXN-3 (Payment Transaction)
  wltId           String   @unique // WLT-1, WLT-2, WLT-3 (Wallet Transaction)
  walletId        String
  type            String   // credit, debit, escrow_hold, escrow_release, escrow_refund
  amount          Float
  balance         Float
  description     String
  orderId         String?
  createdAt       DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
}

model Withdrawal {
  id              String   @id @default(cuid())
  wdrId           String   @unique // WDR-1, WDR-2, WDR-3 (Withdrawal)
  payId           String?  @unique // PAY-1, PAY-2, PAY-3 (Payout - set when approved)
  walletId        String
  amount          Float
  method          String   // bkash, bank_transfer
  accountDetails  String
  status          String   @default("pending") // pending, approved, rejected, completed
  reviewedBy      String?
  reviewNote      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])
}

model Ticket {
  id              String   @id @default(cuid())
  ticketId        String   @unique // ETR-1, ETR-2, ETR-3
  sellerId        String
  transportType   String   // bus, train, flight, launch
  transportCompany String
  ticketType      String   // online_copy, counter_copy
  pnrNumber       String?  // Ticket/PNR Number
  ticketDocument  String?  // PDF for online_copy, image for counter_copy
  routeFrom       String
  routeTo         String
  departureDate   String
  departureTime   String
  boardingPoint   String?
  droppingPoint   String?
  seatClass       String?  // Non AC, AC Economy, AC Business, AC Double Decker, AC Sleeper, AC Suite Class Sleeper
  deckType        String?  // Upper Deck, Lower Deck
  seatNumber      String?
  seatType        String?
  coachNumber     String?
  originalPrice   Float    @default(0)
  price           Float    // Selling price
  platformFee     Float    @default(0)
  totalAmount     Float    @default(0)
  deliveryType    String?  // in_person, courier (for counter_copy only)
  meetingPlace    String?  // Show if deliveryType is in_person
  courierName     String?  // Pathao, Steadfast, Redex, Paperfly, CarryBee, eCourier
  deliverySpeed   String?  // normal, express
  deliveryChargePaidBy String? // seller, buyer
  deliveryCharge  Float    @default(0)
  description     String?
  sellerNotes     String?
  isConfirmed     Boolean  @default(false) // Seller confirmation checkboxes
  status          String   @default("pending_review") // pending_review, active, sold, expired, cancelled
  isFeatured      Boolean  @default(false)
  views           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller  User    @relation("SellerTickets", fields: [sellerId], references: [id])
  orders  Order[]
}

model Order {
  id              String   @id @default(cuid())
  orderId         String   @unique // ORD-1, ORD-2, ORD-3
  ticketId        String
  buyerId         String
  sellerId        String
  amount          Float    // Price seller gets (price - platformFee for online_copy)
  platformFee     Float    // Platform fee amount
  totalAmount     Float    // Total buyer pays (price + platformFee for online_copy, or platformFee only for counter_copy)
  escrowStatus    String   @default("held") // held, released, refunded
  paymentStatus   String   @default("pending") // pending, paid, failed, refunded
  deliveryMethod  String   // online_pdf, in_person, courier
  deliveryStatus  String   @default("pending") // pending, delivered, confirmed
  qrCode          String?  // QR code for counter copy delivery verification
  isQrScanned     Boolean  @default(false)
  status          String   @default("pending") // pending, confirmed, in_progress, completed, cancelled, disputed
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket  Ticket  @relation(fields: [ticketId], references: [id])
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller  User    @relation("SellerOrders", fields: [sellerId], references: [id])
  reviews Review[]
  chat    Chat?
  dispute Dispute?
  journeyVerification JourneyVerification?
  refund  Refund?
  payment PaymentTransaction?
}

model Chat {
  id        String   @id @default(cuid())
  orderId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        Order             @relation(fields: [orderId], references: [id])
  participants ChatParticipant[]
  messages     Message[]
}

model ChatParticipant {
  id     String @id @default(cuid())
  chatId String
  userId String

  chat Chat @relation(fields: [chatId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([chatId, userId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id])
  sender User @relation("MessageSender", fields: [senderId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String
  authorId  String
  targetId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id])
  author User  @relation("ReviewAuthor", fields: [authorId], references: [id])
  target User  @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([orderId, authorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model SupportTicket {
  id          String   @id @default(cuid())
  supId       String   @unique // SUP-1, SUP-2, SUP-3
  userId      String?  // optional for guest submissions
  fullName    String
  phone       String?  // BD format: +88XXXXXXXXXXX
  email       String
  subject     String
  message     String
  attachment  String?  // file path if uploaded
  status      String   @default("open") // open, in_progress, resolved, closed
  priority    String   @default("medium") // low, medium, high, urgent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?             @relation(fields: [userId], references: [id])
  replies     SupportReply[]
}

model SupportReply {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String?
  adminId   String?
  message   String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
}

model Refund {
  id          String   @id @default(cuid())
  refId       String   @unique // REF-1, REF-2, REF-3
  orderId     String   @unique
  initiatedBy String   // buyer, seller, admin
  reason      String
  description String?
  amount      Float
  status      String   @default("pending") // pending, processing, completed, rejected
  processedBy String?
  processNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  author      String?
  categoryId  String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    BlogCategory? @relation(fields: [categoryId], references: [id])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   // percentage, fixed
  value       Float
  minAmount   Float    @default(0)
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int      @default(0)
  validFrom   DateTime
  validUntil  DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usages CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referredId  String   @unique
  reward      Float    @default(0)
  isRewarded  Boolean  @default(false)
  createdAt   DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  group String @default("general")
}

model TransportCompany {
  id            String   @id @default(cuid())
  name          String
  nameBn        String?
  type          String   // bus, train, flight, launch
  logo          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Counter {
  id    String @id @default(cuid())
  name  String @unique
  value Int    @default(0)
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String?
  phone     String?
  otp       String
  type      String   // email_verification, phone_verification, login, forgot_password, admin_login
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Admin {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  role          String   @default("admin") // admin, super_admin
  avatar        String?
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activities    AdminActivityLog[]
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id])
}

model JourneyVerification {
  id        String   @id @default(cuid())
  orderId   String   @unique
  buyerId   String
  photo     String?  // Journey photo URL
  video     String?  // Journey video URL
  gpsLat    Float?   // GPS latitude
  gpsLng    Float?   // GPS longitude
  gpsTimestamp DateTime?
  status    String   @default("pending") // pending, submitted, verified, rejected
  submittedAt DateTime?
  verifiedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Dispute {
  id          String   @id @default(cuid())
  dspId       String   @unique // DSP-1, DSP-2, DSP-3
  orderId     String   @unique
  initiatedBy String   // buyer or seller
  reason      String
  description String?
  status      String   @default("open") // open, investigating, resolved, closed
  resolution  String?
  resolvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Ad {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  link        String?
  placement   String   // homepage, sidebar, header, footer, buy-tickets, dashboard
  type        String   @default("banner") // banner, popup, text
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogCategory {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique

  posts BlogPost[]
}

model BlogTag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
}

model PaymentTransaction {
  id                String   @id @default(cuid())
  payId             String   @unique // PAY-1, PAY-2 (using id-prefix scheme)
  orderId           String?  @unique // Link to Order if applicable
  tranId            String   @unique // SSLCommerz transaction ID (our tran_id)
  valId             String?  // SSLCommerz validation ID
  sessionKey        String?  // SSLCommerz session key
  
  // Amount tracking
  amount            Float    // Original amount sent to SSLCommerz
  storeAmount       Float?   // Amount after bank charges (from SSLCommerz)
  currency          String   @default("BDT")
  currencyType      String?  @default("BDT")
  currencyAmount    Float?   // Amount in original currency
  
  // Payment details
  paymentMethod     String?  // sslcommerz, bkash, googlepay, quickbankpay
  cardType          String?  // VISA-Brac bank, MASTER-DBBL, bKash, etc.
  cardNo            String?  // Masked card number or reference ID
  cardIssuer        String?  // Issuer bank name
  cardBrand         String?  // VISA, MASTER, AMEX, IB, MOBILE BANKING
  bankTranId        String?  // Bank transaction ID
  
  // Customer info (from SSLCommerz response)
  cusName           String?
  cusEmail          String?
  cusPhone          String?
  cusAdd1           String?
  cusCity           String?
  cusCountry        String?
  
  // Risk assessment
  riskLevel         Int      @default(0) // 0=safe, 1=risky
  riskTitle         String?  // Safe, Risky
  
  // Status tracking
  status            String   @default("pending") // pending, valid, validated, failed, cancelled, unattempted, expired
  paymentStatus     String   @default("pending") // pending, paid, failed, refunded
  escrowStatus      String?  // held, released, refunded
  
  // Invoice-specific fields
  invoiceId         String?  @unique // SSLCommerz invoice ID (for invoice payments)
  payUrl            String?  // Shareable payment link (for invoices)
  qrPayUrl          String?  // QR payment URL (for invoices)
  banglaQrCode      String?  // Bangla QR content
  
  // Quick Bank Pay-specific fields
  utilityCode       String?  // Utility code for Quick Bank Pay
  billType          String?  // education, isp, insurance
  referenceId       String?  // Reference ID for the bill
  confirmationId    String?  // Payment confirmation ID
  
  // Google Pay-specific fields
  googlePaySessionKey String? // Google Pay session key
  googlePayActionUrl  String? // Google Pay token submission URL
  
  // Refund tracking
  refundRefId       String?  // Refund reference ID from SSLCommerz
  refundAmount      Float?   // Amount refunded
  refundStatus      String?  // processing, refunded, cancelled
  refundRemarks     String?  // Reason for refund
  
  // Custom values (value_a through value_d)
  valueA            String?
  valueB            String?
  valueC            String?
  valueD            String?
  
  // Timestamps
  paidAt            DateTime?
  validatedAt       DateTime?
  refundedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  order             Order?   @relation(fields: [orderId], references: [id])
}

model FaqCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  items FaqItem[]
}

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "how-it-works", "safety-guidelines", "payment-policy"
  title     String   // Page title
  titleBn   String?  // Bengali title
  content   String   // Main content as JSON string (array of sections with title, body, icon)
  contentBn String?  // Bengali content as JSON string
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model HomepageSection {
  id          String   @id @default(cuid())
  sectionKey  String   @unique // e.g. "hero", "stats", "features", "how_it_works", "popular_routes", "cta"
  title       String
  titleBn     String?
  subtitle    String?
  subtitleBn  String?
  content     String?  // JSON string for section-specific data (stats values, feature list, steps, routes)
  contentBn   String?  // Bengali content JSON
  isVisible   Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model FaqItem {
  id          String   @id @default(cuid())
  categoryId  String
  question    String
  questionBn  String?
  answer      String
  answerBn    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category FaqCategory @relation(fields: [categoryId], references: [id])
}

model IpBlock {
  id          String   @id @default(cuid())
  ipAddress   String   @unique
  reason      String?
  blockedBy   String?
  createdAt   DateTime @default(now())
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  permissions String?  // JSON array of allowed operations
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  permission String // e.g. "manage_tickets", "manage_users", "view_reports"

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}
