# Database
# For Vercel deployment (PostgreSQL — REQUIRED for serverless):
DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# For local development (SQLite — NOT compatible with PostgreSQL schema):
# DATABASE_URL=file:./db/custom.db

# NextAuth (optional - configure when ready)
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=https://your-domain.vercel.app

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_SANDBOX=true

# SSLCommerz Quick Bank Pay
SSLCOMMERZ_QBP_API_KEY=your_api_key
SSLCOMMERZ_QBP_STK_CODE=SSLC
SSLCOMMERZ_QBP_AUTH_KEY=your_auth_key

# SSLCommerz Google Pay
SSLCOMMERZ_GP_MERCHANT_ID=your_google_merchant_id
SSLCOMMERZ_GP_AES_SALT=F5d66a527ff181486321bf7c3s7f54de

# bKash Payment Gateway (Tokenized Checkout v1.2.0-beta)
BKASH_APP_KEY=your_app_key
BKASH_APP_SECRET=your_app_secret
BKASH_USERNAME=your_username
BKASH_PASSWORD=your_password
BKASH_IS_SANDBOX=true
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=http://localhost:3000/api/payment/bkash/callback
