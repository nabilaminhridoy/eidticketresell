# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
db/*.db
db/*.db-journal

# sandbox/dev specific
.claude
.z-ai-config
*.log
dev.log
dev.out.log
server.log
server.pid
.next-dev.pid
keep-server-alive.sh
Caddyfile

# skills (AI skill files, not needed for deployment)
/skills/

# agent context (development session files)
/agent-ctx/

# tool results (session output)
/tool-results/

# screenshots (QA/debug screenshots)
/screenshots/
*.png
!public/**/*.png

# test results
/test-results/

# download folder
/download/

# examples (demo code)
/examples/

# scripts (sandbox-specific scripts)
/scripts/

# zscripts (sandbox-specific dev scripts)
/.zscripts/

# worklog
/worklog.md

# upload temp files
/public/uploads/*.png
/public/uploads/*.jpg
/public/uploads/*.jpeg
/public/uploads/*.webp

# mini-services node_modules
mini-services/*/node_modules

# bun lock (optional, can regenerate)
# bun.lock
/upload
